rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only access their own user details
    match /UsersDetails/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow authenticated users to read exercises; only trainers can write
    match /Exercises/{exerciseId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/UsersDetails/$(request.auth.uid)).data.isTrainer == true;
    }

    // Trainers can only read/write their own routines; trainees can read routines assigned to them
    match /Routines/{routineId} {
      allow read: if request.auth != null && (
        resource.data.createdBy == request.auth.uid ||
        resource.data.assignees.hasAny([{'traineeId': request.auth.uid}])
      );
      allow create: if request.auth != null &&
        request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if request.auth != null &&
        resource.data.createdBy == request.auth.uid;
    }

    // Users can read their own transactions; writes are server-only (Phase 1+)
    // resource.data is null on creates, so use request.resource.data for create checks
    match /TransactionDetails/{transactionId} {
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        resource.data.clientId == request.auth.uid
      );
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null &&
        resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // Users can read their own subscriptions; writes are server-only (Phase 1+)
    match /Subscriptions/{subscriptionId} {
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        resource.data.clientId == request.auth.uid
      );
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null &&
        resource.data.userId == request.auth.uid;
      allow delete: if false;
    }
  }
}